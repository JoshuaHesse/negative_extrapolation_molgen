FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime@sha256:c8268a92a69bd500f8be0e665b2630ee006dadaf7bfbc24249141b15ff622755

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    libxext6 \
    libxrender1 \
    openbabel \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/neon_molecular_generation

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements.txt \
    && python -m pip install \
        numpy==1.26.2 \
        pandas==2.2.2 \
        scipy==1.11.4 \
        lightning==2.6.5 \
        torchmetrics==1.9.0 \
        openbabel-wheel==3.1.1.23 \
        typing_extensions==4.15.0 \
        posebusters==0.6.5

COPY pyproject.toml README.md ./
COPY neon_molgen ./neon_molgen
RUN python -m pip install --no-deps -e .

CMD ["bash"]
